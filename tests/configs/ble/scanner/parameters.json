{
    "test": "scanner",
    "source": {
        "workbook": "CurrentMeasApp.xlsx",
        "sheet": "Sheet1"
    },
    "generator": {
        "base_config": "default.json",
        "output_dir": ".",
        "name_rule": "concise_parameter_value",
        "name_separator": "_",
        "steps": 4,
        "analyses": {
            "one_factor": {
                "enabled": true
            },
            "full_sweep": {
                "enabled": true,
                "output_dir": "full_sweep",
                "partition_by": "dcdc",
                "partition_dirs": {
                    "On": "dcdc",
                    "Off": "no_dcdc"
                },
                "name_order": [
                    "scanning_interval",
                    "scanning_window",
                    "phy",
                    "dcdc"
                ]
            }
        }
    },
    "parameters": [
        {
            "name": "dcdc",
            "label": "DCDC",
            "control": "compile",
            "default": "On",
            "file_token": "dcdc",
            "omit_value_in_name": [
                "Off"
            ],
            "values": [
                "On",
                "Off"
            ],
            "config_path": "firmware.dut_slcp",
            "options": {
                "On": "apps/ncp_ble_dut_dcdc.slcp",
                "Off": "apps/ncp_ble_dut.slcp"
            }
        },
        {
            "name": "phy",
            "label": "Phy",
            "control": "bgapi",
            "default": "1mbps",
            "file_token": "phy",
            "config_path": "scanner.phy",
            "values": [
                "125kbps",
                "500kbps",
                "1000kbps",
                "2000kbps"
            ]
        },
        {
            "name": "scanning_interval",
            "label": "Scanning Interval",
            "control": "bgapi",
            "default": "100 ms",
            "file_token": "scanint",
            "range": {
                "min": "2.5 ms",
                "max": "10 s"
            },
            "config_path": "scanner.interval"
        },
        {
            "name": "scanning_window",
            "label": "Scanning Window",
            "control": "bgapi",
            "default": "20 ms",
            "file_token": "scanwin",
            "range": {
                "min": "2.5 ms",
                "max": "10 s"
            },
            "config_path": "scanner.window"
        }
    ]
}
