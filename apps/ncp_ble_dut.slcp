# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: NCPCurrentMeasurement
label: NCPCurrentMeasurementDUT
description: |
  Network Co-Processor (NCP) target application. Runs the Bluetooth stack dynamically and provides access to it via Bluetooth API (BGAPI) using UART connection. NCP mode makes it possible to run your application on a host controller or PC.
category: Bluetooth Examples
filter:
- name: Device Type
  value:
  - NCP
- name: Project Difficulty
  value:
  - Beginner
- name: Wireless Technology
  value:
  - Bluetooth
package: Bluetooth
quality: production
readme:
- path: readme.md
source:
- path: src/app.c
tag:
- prebuilt_demo
- hardware:rf:band:2400
include:
- path: src
  file_list:
  - path: app.h
sdk:
  vendor: null
  id: simplicity_sdk
  version: 2025.6.2
toolchain_settings: [
  ]
component:
- id: EFR32MG22C224F512IM40
- id: app_assert
- id: app_os_helper
- id: bluetooth_feature_connection_role_central
- id: bluetooth_feature_connection_role_peripheral
- id: bluetooth_feature_dynamic_gattdb
- id: bluetooth_feature_extended_advertiser
- id: bluetooth_feature_extended_scanner
- id: bluetooth_feature_gap
- id: bluetooth_feature_gatt
- id: bluetooth_feature_gatt_server
- id: bluetooth_feature_legacy_advertiser
- id: bluetooth_feature_legacy_scanner
- id: bluetooth_feature_nvm
- id: bluetooth_feature_periodic_advertiser
- id: bluetooth_feature_pawr_advertiser
- id: bluetooth_feature_pawr_sync
- id: bluetooth_feature_sm
- id: bluetooth_feature_sync
- id: bluetooth_feature_sync_scanner
- id: bluetooth_feature_system
- id: bluetooth_feature_test
- id: bluetooth_stack
- id: bootloader_interface
- id: brd4002a
- id: brd4182a_b06
- id: clock_manager
- id: device_init
- id: mpu
- id: ncp
- id: ncp_user_cmd
- id: sl_main
- instance:
  - vcom
  id: uartdrv_usart
- id: wake_lock
other_file:
- path: image/readme_img0.png
- path: image/readme_img1.png
- path: image/readme_img2.png
- path: image/readme_img3.png
- path: image/readme_img4.png
- path: image/readme_img5.png
- path: image/readme_img7.png
configuration:
- name: SL_STACK_SIZE
  value: '2752'
- name: SL_BT_CONFIG_USER_ADVERTISERS
  value: '4'
- name: SL_BOARD_ENABLE_VCOM
  value: '1'
- name: SL_UARTDRV_USART_VCOM_FLOW_CONTROL_TYPE
  value: uartdrvFlowControlHw
- condition:
  - psa_crypto
  name: SL_PSA_KEY_USER_SLOT_COUNT
  value: '0'
- name: SL_DEVICE_INIT_DCDC_ENABLE
  value: 0
- name: RADIOPRS_RX_CHANNEL
  value: 0
- name: RADIOPRS_RX_SOURCESEL
  value: PRS_RACL_LNAEN
- name: RADIOPRS_RX_PORT
  value: SL_GPIO_PORT_B
- name: RADIOPRS_RX_PIN
  value: 2
- name: RADIOPRS_TX_CHANNEL
  value: 1
- name: RADIOPRS_TX_SOURCESEL
  value: PRS_RACL_PAEN
- name: RADIOPRS_TX_PORT
  value: SL_GPIO_PORT_B
- name: RADIOPRS_TX_PIN
  value: 3
- name: SL_WAKE_LOCK_INPUT_PORT
  value: SL_GPIO_PORT_B
- name: SL_WAKE_LOCK_INPUT_PIN
  value: 1
- name: SL_WAKE_LOCK_ENABLE_REMOTE
  value: 0
- name: SL_WAKE_LOCK_INPUT_POLARITY_ACTIVE_HIGH
  value: 0
- name: UARTDRV_RESTRICT_ENERGY_MODE_TO_ALLOW_RECEPTION
  value: 0
ui_hints:
  highlight:
